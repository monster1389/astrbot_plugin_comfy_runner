{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Comfy Runner Workflow Tool Contract v1",
  "description": "Validates a .tool.json file. Runtime tool parameter schemas are derived from the inputs mapping.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "name",
    "description",
    "enabled",
    "inputs",
    "outputs"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{0,63}$"
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "enabled": {
      "type": "boolean"
    },
    "inputs": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_]{0,63}$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/input"
      }
    },
    "outputs": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_]{0,63}$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/output"
      }
    }
  },
  "$defs": {
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "node",
        "field"
      ],
      "properties": {
        "node": {
          "type": "string",
          "minLength": 1
        },
        "field": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "description",
        "target"
      ],
      "properties": {
        "type": {
          "enum": [
            "string",
            "integer",
            "number",
            "boolean"
          ]
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "required": {
          "type": "boolean",
          "default": false
        },
        "target": {
          "$ref": "#/$defs/target"
        },
        "enum": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true
        },
        "minLength": {
          "type": "integer",
          "minimum": 0
        },
        "maxLength": {
          "type": "integer",
          "minimum": 0
        },
        "minimum": {
          "type": "number"
        },
        "maximum": {
          "type": "number"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "string"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "enum": {
                "items": {
                  "type": "string"
                }
              },
              "minimum": false,
              "maximum": false
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "integer"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "enum": {
                "items": {
                  "type": "integer"
                }
              },
              "minLength": false,
              "maxLength": false,
              "minimum": {
                "type": "integer"
              },
              "maximum": {
                "type": "integer"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "number"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "enum": {
                "items": {
                  "type": "number"
                }
              },
              "minLength": false,
              "maxLength": false
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "boolean"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "enum": false,
              "minLength": false,
              "maxLength": false,
              "minimum": false,
              "maximum": false
            }
          }
        }
      ]
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "target"
      ],
      "properties": {
        "type": {
          "enum": [
            "image",
            "video",
            "audio",
            "text",
            "file"
          ]
        },
        "target": {
          "$ref": "#/$defs/target"
        }
      }
    }
  }
}
